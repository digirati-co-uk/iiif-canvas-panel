{
  "name": "canvas-panel-docs",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "prepare": "husky",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "custom-install": "pnpm install --frozen-lockfile",
    "custom-build": "pnpm build",
    "docusaurus": "docusaurus",
    "start": "pnpm dev",
    "build": "pnpm build:runtime && pnpm build:examples && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "pnpm build:runtime && pnpm build:examples && docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "sandbox": "node cli.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:docs": "docusaurus start --host 127.0.0.1 --port 3000 --no-open",
    "dev:app": "pnpm --filter @digirati/canvas-panel-web-components dev --host 127.0.0.1 --port 5173 --strictPort",
    "build:runtime": "pnpm --filter @digirati/canvas-panel-web-components build && tsdown --config scripts/tsdown.docs.mts",
    "test:docs": "node scripts/check-docs.mjs",
    "test:demos": "node scripts/check-docs.mjs --demos",
    "test:renderer": "node scripts/check-renderer.mjs",
    "build:examples": "pnpm --filter @canvas-panel/examples build",
    "test:examples": "pnpm --filter @canvas-panel/examples test && pnpm --filter @canvas-panel/examples typecheck && pnpm --filter @canvas-panel/examples exec tsc -p ../tsconfig.examples.json",
    "test:example-packages": "node sandboxes/check-consumers.mjs",
    "test:example-ui": "node scripts/check-examples.mjs",
    "test:react-consumer": "node scripts/check-react-consumer.mjs",
    "test:media-slots": "node scripts/check-media-slots.mjs",
    "test:timeline": "node scripts/check-timeline.mjs"
  },
  "dependencies": {
    "@cmfcmf/docusaurus-search-local": "^2.0.1",
    "@digirati/canvas-panel-web-components": "workspace:*",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@iiif/helpers": "4.0.0",
    "@iiif/parser": "4.0.1",
    "@mdx-js/react": "^3.1.1",
    "@stackblitz/sdk": "1.11.1",
    "clsx": "^1.1.1",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@docusaurus/theme-classic": "3.10.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.69.0",
    "oxlint": "^1.84.0",
    "pkg-pr-new": "0.0.88",
    "playwright": "1.63.0",
    "raw-loader": "4.0.2",
    "tsdown": "^0.23.0",
    "typescript": "~6.0.3",
    "yargs": "^18.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": "oxlint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
