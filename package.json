{
  "name": "canvas-panel-docs",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "prepare": "husky",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "custom-install": "pnpm install --frozen-lockfile",
    "custom-build": "pnpm build",
    "docusaurus": "docusaurus",
    "start": "pnpm dev",
    "build": "pnpm build:runtime && pnpm build:examples && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "pnpm build:runtime && pnpm build:examples && docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "sandbox": "node cli.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:docs": "docusaurus start --host 127.0.0.1 --port 3000 --no-open",
    "dev:app": "pnpm --filter @digirati/canvas-panel-web-components dev --host 127.0.0.1 --port 5173 --strictPort",
    "build:runtime": "pnpm --filter @digirati/canvas-panel-web-components build && tsdown --config scripts/tsdown.docs.mts",
    "test:docs": "node scripts/check-docs.mjs",
    "test:demos": "node scripts/check-docs.mjs --demos",
    "test:renderer": "node scripts/check-renderer.mjs",
    "build:examples": "pnpm --filter @canvas-panel/examples build",
    "test:examples": "pnpm --filter @canvas-panel/examples test && pnpm --filter @canvas-panel/examples typecheck && pnpm --filter @canvas-panel/examples exec tsc -p ../tsconfig.examples.json",
    "test:example-packages": "node sandboxes/check-consumers.mjs",
    "test:example-ui": "node scripts/check-examples.mjs"
  },
  "dependencies": {
    "@cmfcmf/docusaurus-search-local": "^0.11.0",
    "@digirati/canvas-panel-web-components": "workspace:*",
    "@docusaurus/core": "2.0.0-beta.22",
    "@docusaurus/preset-classic": "2.0.0-beta.22",
    "@docusaurus/theme-common": "2.0.0-beta.22",
    "@iiif/helpers": "4.0.0",
    "@iiif/parser": "4.0.1",
    "@mdx-js/react": "^1.6.21",
    "@stackblitz/sdk": "1.11.1",
    "@svgr/webpack": "^5.5.0",
    "clsx": "^1.1.1",
    "file-loader": "^6.2.0",
    "prism-react-renderer": "^1.2.1",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "url-loader": "^4.1.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.69.0",
    "oxlint": "^1.84.0",
    "pkg-pr-new": "0.0.88",
    "playwright": "1.57.0",
    "raw-loader": "4.0.2",
    "tsdown": "^0.17.4",
    "yargs": "*"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": "oxlint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "pnpm": {
    "overrides": {
      "@cmfcmf/docusaurus-search-local>cheerio": "1.0.0-rc.12"
    }
  }
}
