{
  "name": "canvas-panel-docs",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "custom-install": "pnpm install --frozen-lockfile",
    "custom-build": "pnpm build",
    "docusaurus": "docusaurus",
    "start": "pnpm dev",
    "build": "pnpm build:runtime && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "pnpm build:runtime && docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "sandbox": "node cli.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:docs": "docusaurus start --host 127.0.0.1 --port 3000 --no-open",
    "dev:app": "pnpm --filter @digirati/canvas-panel-web-components dev --host 127.0.0.1 --port 5173 --strictPort",
    "build:runtime": "pnpm --filter @digirati/canvas-panel-web-components build && tsdown --config scripts/tsdown.docs.mts",
    "test:docs": "node scripts/check-docs.mjs",
    "test:demos": "node scripts/check-docs.mjs --demos"
  },
  "dependencies": {
    "@cmfcmf/docusaurus-search-local": "^0.11.0",
    "@codesandbox/sandpack-react": "^0.14.2",
    "@digirati/canvas-panel-web-components": "workspace:*",
    "@docusaurus/core": "2.0.0-beta.22",
    "@docusaurus/preset-classic": "2.0.0-beta.22",
    "@iiif/helpers": "4.0.0",
    "@iiif/parser": "4.0.1",
    "@mdx-js/react": "^1.6.21",
    "@svgr/webpack": "^5.5.0",
    "clsx": "^1.1.1",
    "file-loader": "^6.2.0",
    "prism-react-renderer": "^1.2.1",
    "react": "^17.0.1",
    "react-dom": "^17.0.1",
    "url-loader": "^4.1.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "playwright": "1.57.0",
    "raw-loader": "^4.0.2",
    "tsdown": "^0.17.4",
    "yargs": "*"
  },
  "pnpm": {
    "overrides": {
      "@cmfcmf/docusaurus-search-local>cheerio": "1.0.0-rc.12"
    }
  }
}
