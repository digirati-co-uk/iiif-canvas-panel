{
  "name": "@digirati/canvas-panel-web-components",
  "version": "1.0.73",
  "main": "./dist/index.cjs",
  "type": "module",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:package": "node scripts/check-package.mjs",
    "build": "tsdown && tsdown --config ./tsdown.umd.ts",
    "prepack": "NODE_ENV=production tsdown && tsdown --config ./tsdown.umd.ts",
    "dev:bundle": "tsdown --config ./tsdown.umd.ts --watch"
  },
  "dependencies": {
    "@atlas-viewer/atlas": "3.2.5",
    "@atlas-viewer/iiif-image-api": "2.2.2",
    "@iiif/helpers": "4.0.0",
    "@iiif/parser": "4.0.1",
    "@preact/compat": "17.*",
    "@react-hook/media-query": "^1.1.1",
    "preact": "^10.*",
    "react-error-boundary": "^3.1.4",
    "react-iiif-vault": "https://pkg.pr.new/digirati-co-uk/react-iiif-vault/react-iiif-vault@0c2c25b",
    "react-reconciler": "0.33.0",
    "tsdown": "^0.17.4"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.3.0",
    "@types/jest": "^28.1.4",
    "@types/preact-custom-element": "^4.0.1",
    "@types/react": "^17.0.39",
    "@types/react-dom": "^17.0.13",
    "@typescript-eslint/eslint-plugin": "^5.14.0",
    "@typescript-eslint/parser": "^5.14.0",
    "esbuild": "^0.14.25",
    "eslint": "^8.10.0",
    "eslint-plugin-json": "^3.1.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-unused-imports": "^2.0.0",
    "happy-dom": "^6.0.3",
    "jest": "^28.1.2",
    "preact-render-to-string": "^5.2.0",
    "prettier": "^2.5.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ts-jest": "^28.0.5",
    "typescript": "^5.9.3",
    "vite": "^2.9.5",
    "vitest": "^0.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./dist/index.iife.js": "./dist/index.iife.js",
    "./package.json": "./package.json",
    "./dist/index.css": "./dist/index.css"
  }
}
