{
  "name": "@digirati/canvas-panel-web-components",
  "version": "1.0.73",
  "main": "./dist/index.cjs",
  "type": "module",
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:package": "node scripts/check-package.mjs",
    "build": "tsdown && tsdown --config ./tsdown.umd.ts",
    "prepack": "NODE_ENV=production tsdown && tsdown --config ./tsdown.umd.ts",
    "dev:bundle": "tsdown --config ./tsdown.umd.ts --watch"
  },
  "dependencies": {
    "@atlas-viewer/atlas": "https://pkg.pr.new/atlas-viewer/atlas/@atlas-viewer/atlas@a2c97eb",
    "@atlas-viewer/iiif-image-api": "2.2.2",
    "@iiif/helpers": "4.0.0",
    "@iiif/parser": "4.0.1",
    "react-error-boundary": "^3.1.4",
    "react-iiif-vault": "https://pkg.pr.new/digirati-co-uk/react-iiif-vault/react-iiif-vault@1c82c77",
    "react-reconciler": "0.33.0"
  },
  "devDependencies": {
    "@types/jest": "^28.1.4",
    "@types/react": "^17.0.39",
    "@types/react-dom": "^17.0.13",
    "esbuild": "^0.14.25",
    "happy-dom": "^6.0.3",
    "jest": "^28.1.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ts-jest": "^28.0.5",
    "typescript": "^5.9.3",
    "vite": "^2.9.5",
    "vitest": "^0.18.0",
    "tsdown": "^0.17.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./dist/index.iife.js": "./dist/index.iife.js",
    "./package.json": "./package.json",
    "./dist/index.css": "./dist/index.css"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  }
}
